# Copy to .env and edit. The gateway reads this file directly.
# It does not export these values into the process environment or the shell.
# Public gateway Streamable HTTP bind address.
HTTP_ADDR=127.0.0.1:8080

# Upstream official ClickHouse MCP transport: stdio or http.
CLICKHOUSE_MCP_TRANSPORT=stdio

# stdio: executable plus a JSON array of arguments. The gateway does not use a shell.
CLICKHOUSE_MCP_COMMAND=uv
CLICKHOUSE_MCP_ARGS=["run","--with","mcp-clickhouse","--python","3.12","mcp-clickhouse"]

# JSON object passed to the upstream process only. ClickHouse connection settings belong here.
# Do not put these values in the gateway's own database configuration; there is none.
CLICKHOUSE_MCP_ENV={"CLICKHOUSE_HOST":"localhost","CLICKHOUSE_USER":"readonly","CLICKHOUSE_PASSWORD":"replace-me","CLICKHOUSE_SECURE":"false","CLICKHOUSE_PORT":"8123"}

# The only ClickHouse database this gateway will reference.
REFER_DATABASE=lafdatav1

# http transport. Use the MCP URL, usually http://127.0.0.1:8000/mcp.
# CLICKHOUSE_MCP_URL=http://127.0.0.1:8000/mcp
# Sent only as Authorization: Bearer. Never logged.
# CLICKHOUSE_MCP_AUTH_TOKEN=replace-me

QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=200
MAX_RESPONSE_BYTES=1048576

# Reject SELECT * and queries without an aggregate in the select list.
AGGREGATION_ONLY=false

# Query traces always include the SQL. Leave false to redact quoted string literals.
LOG_SQL=false
