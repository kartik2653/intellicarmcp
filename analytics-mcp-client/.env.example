# Copy to .env. The client reads this file and does not export the values.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=32000

# Streamable HTTP endpoint of the existing Go MCP gateway.
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Sent as Authorization: Bearer on every gateway request. The gateway forwards it to the permissions API.
ANALYTICS_ACCESS_TOKEN=replace-me

# The only ClickHouse database Claude should reference. The gateway enforces the same name.
REFER_DATABASE=lafdatav1

MAX_TOOL_CALLS=10
REQUEST_TIMEOUT_SECONDS=60
