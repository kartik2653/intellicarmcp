# Copy to .env. The client reads this file and does not export the values.
XAI_API_KEY=replace-me
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Streamable HTTP endpoint of the existing Go MCP gateway.
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# The only ClickHouse database Grok should reference. The gateway enforces the same name.
REFER_DATABASE=lafdatav1

MAX_TOOL_CALLS=10
REQUEST_TIMEOUT_SECONDS=60
